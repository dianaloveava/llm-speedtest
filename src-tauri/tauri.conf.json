{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "LLM SpeedTest",
  "version": "1.0.0",
  "identifier": "com.dianaloveava.llmspeedtest",
  "build": {
    "frontendDist": "../dist",
    "beforeDevCommand": "node scripts/build-web.mjs",
    "beforeBuildCommand": "node scripts/build-web.mjs"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "LLM SpeedTest",
        "width": 1440,
        "height": 900,
        "minWidth": 960,
        "minHeight": 600,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ]
  }
}
